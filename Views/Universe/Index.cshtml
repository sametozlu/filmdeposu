@model UniverseIndexViewModel
@{
    ViewData["Title"] = L.T("universe_title");
}

<section class="section reveal-on-scroll">
    <div class="section-header">
        <h1>@L.T("universe_title")</h1>
        <p>@L.T("universe_desc")</p>
    </div>
    <div class="universe-grid">
        @foreach (var map in Model.Maps)
        {
            <a asp-action="Detail" asp-route-id="@map.Id" class="universe-card">
                <h3>@map.Title</h3>
                <p>@map.Description</p>
                <span class="universe-link">→</span>
            </a>
        }
    </div>
</section>
