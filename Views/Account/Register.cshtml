@model RegisterViewModel
@{
    ViewData["Title"] = L.T("register_title");
}

<section class="section auth-section">
    <h1>@L.T("register_title")</h1>
    <form asp-action="Register" method="post" class="auth-form">
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="DisplayName">@L.T("display_name")</label>
        <input asp-for="DisplayName" required />
        <label asp-for="Email">@L.T("email")</label>
        <input asp-for="Email" type="email" required />
        <label asp-for="Password">@L.T("password")</label>
        <input asp-for="Password" type="password" required />
        <label asp-for="ConfirmPassword">@L.T("password")</label>
        <input asp-for="ConfirmPassword" type="password" required />
        <button type="submit" class="btn btn-primary">@L.T("register_title")</button>
    </form>
    <p><a asp-action="Login">@L.T("login_title")</a></p>
</section>
