@model ResetPasswordViewModel
@{
    ViewData["Title"] = L.T("reset_password");
}

<section class="section auth-section">
    <h1>@L.T("reset_password")</h1>
    <form asp-action="ResetPassword" method="post" class="auth-form">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="Password">@L.T("new_password")</label>
        <input asp-for="Password" type="password" required />
        <label asp-for="ConfirmPassword">@L.T("confirm_password")</label>
        <input asp-for="ConfirmPassword" type="password" required />
        <button type="submit" class="btn btn-primary">@L.T("reset_password")</button>
    </form>
</section>
