@model ForgotPasswordViewModel
@{
    ViewData["Title"] = L.T("forgot_password");
}

<section class="section auth-section">
    <h1>@L.T("forgot_password")</h1>
    <p>@L.T("forgot_password_desc")</p>
    <form asp-action="ForgotPassword" method="post" class="auth-form">
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="Email">@L.T("email")</label>
        <input asp-for="Email" type="email" required />
        <button type="submit" class="btn btn-primary">@L.T("send_reset_link")</button>
    </form>
    <p><a asp-action="Login">← @L.T("login_title")</a></p>
</section>
